---
/**
 * Navbar: la marca a la izquierda, el cambio de tema a la derecha y, en el
 * medio, TODAS las secciones. La activa va en tinta con un punto lima debajo;
 * las demás, en el gris que le sigue en la paleta de la app.
 *
 * Varias secciones seguidas con el mismo `nombre` son un grupo (Cómo funciona:
 * registro, organiza, ingresos, reportes): su ítem lleva un punto por sección
 * y el lima marca en cuál vas.
 *
 * Lo actualiza el evento `spook:paso` que emite el fantasma al cambiar de
 * sección, y al pulsar un ítem se le pide ir allí con `spook:ir`.
 *
 * OJO: estos nombres tienen que coincidir con los `nombre` de las secciones.
 */
const items = ['Inicio', 'Qué es', 'Cómo funciona', 'Descarga'];
---

<header class="bar">
  <div class="inner">
    <a class="brand" href="/">Spook AI</a>

    <nav aria-label="Secciones">
      <ul>
        {items.map((nombre, i) => (
          <li>
            <button
              type="button"
              class:list={['item', { on: i === 0 }]}
              data-item={nombre}
              aria-current={i === 0 ? 'step' : undefined}
            >
              {nombre}
              <span class="puntos" aria-hidden="true">{i === 0 && <i class="on"></i>}</span>
            </button>
          </li>
        ))}
      </ul>
    </nav>

    <button id="theme-toggle" class="toggle" type="button" aria-label="Cambiar de tema">
      <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
      <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
      </svg>
    </button>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    /* Sin filete inferior: el desenfoque ya separa la barra del contenido.
       Una línea de 1px de lado a lado es lo que delata una plantilla. */
    transition: background-color 0.28s ease;
  }

  /* Su propia columna, de 900px: más ancha que la del contenido (800px). */
  /* Tres columnas: el indicador queda centrado en la BARRA y no entre la marca
     y el botón — con un flex simple, el ancho de la marca lo desplazaría. */
  .inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    /* El alto lo fija el token, no los hijos. Antes lo daba el `min-height` de
       los enlaces; al quitarlos la barra encogió a la altura del botón y dejó
       de cuadrar con lo que las secciones descuentan. */
    min-height: var(--nav-h);
    max-width: var(--nav-max);
    margin-inline: auto;
    padding-inline: var(--col-pad);
  }

  .brand {
    /* Sin esto el enlace se estira a toda su columna del grid y se podía
       pulsar muy lejos del texto. */
    justify-self: start;
    /* Una sola línea siempre: sin esto, en pantallas estrechas se partía en
       "Spook / AI" y la barra crecía a dos filas. */
    white-space: nowrap;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    /* La marca no es un estado de navegación: va siempre en la tinta que
       manda, no en el gris de lo inactivo. */
    color: var(--fg);
    text-decoration: none;
    transition: color 0.28s ease;
  }

  /* -------------------------------------------------------------- items -- */

  ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--nav-h);
    padding: 0 0.75rem;
    border: 0;
    background: none;
    font: inherit;
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    white-space: nowrap;
    /* Inactivo: el gris callado de la app. */
    color: var(--fg-3);
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .item:hover { color: var(--fg-2); }
  .item.on { color: var(--fg); cursor: default; }

  /* Los puntos van debajo del nombre, centrados. Solo el ítem activo los
     tiene: uno, o uno por sección si es un grupo. */
  .puntos {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    bottom: calc(50% - 0.5rem - 10px);
    display: flex;
    gap: 5px;
  }
  /* `:global` porque los puntos los rehace el script, y los elementos creados
     desde JS no llevan el atributo de ámbito de Astro: una regla con ámbito
     no los alcanzaría. */
  .puntos :global(i) {
    display: block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--fg-4);
    transition: background-color 0.25s ease;
  }
  .puntos :global(i.on) { background: var(--accent); }

  /* -------------------------------------------------------------- toggle -- */

  .toggle {
    /* Al otro extremo: el hueco hasta el borde derecho es el mismo que el de
       la marca hasta el izquierdo, porque comparten el padding de la columna. */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    /* En la tinta que manda, como la marca: negro en claro, blanco en
       oscuro. */
    color: var(--fg);
    justify-self: end;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.28s ease;
  }
  /* Al pasar por encima cambia el fondo, no el icono. */
  .toggle:hover {
    background: var(--card);
  }
  .toggle svg {
    width: 20px;
    height: 20px;
    /* Relleno además del trazo: la luna queda maciza y el sol con su disco
       lleno. Los rayos son segmentos sin área, así que el relleno no los
       afecta. */
    fill: currentColor;
  }

  /* Se muestra el icono del tema al que se VA, no el actual. */
  .sun  { display: none; }
  :global(:root[data-theme="dark"]) .moon { display: none; }
  :global(:root[data-theme="dark"]) .sun  { display: block; }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .moon { display: none; }
    :global(:root:not([data-theme="light"])) .sun  { display: block; }
  }
  /* Una elección explícita gana siempre sobre la preferencia del sistema. */
  :global(:root[data-theme="light"]) .moon { display: block; }
  :global(:root[data-theme="light"]) .sun  { display: none; }

  /* En teléfono no caben la marca, los cuatro ítems y el botón: la marca se
     retira (el titular de la portada ya dice «Spook AI») y los ítems se
     aprietan. */
  @media (max-width: 640px) {
    .inner { grid-template-columns: minmax(0, 1fr) auto; column-gap: 0.5rem; }
    .brand { display: none; }
    /* El primer ítem se come su propio relleno para quedar alineado con el
       borde de la columna. Si aun así no cabe (teléfonos de 320px), la fila
       se desliza de lado en vez de empujar el botón fuera. */
    nav { justify-self: start; min-width: 0; max-width: 100%; margin-left: -0.45rem; overflow-x: auto; }
    ul { gap: 0; }
    .item { padding-inline: 0.45rem; font-size: 0.875rem; }
    .toggle { width: 40px; height: 40px; margin-right: -0.5rem; }
    .toggle svg { width: 18px; height: 18px; }
  }
  @media (max-width: 380px) {
    .item { padding-inline: 0.35rem; font-size: 0.8125rem; }
  }
</style>

<script>
  const KEY = 'spook-theme';
  const root = document.documentElement;
  const button = document.getElementById('theme-toggle');

  const label = (theme: string) =>
    theme === 'dark' ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro';

  const paint = (theme: string) => {
    root.dataset.theme = theme;
    button?.setAttribute('aria-label', label(theme));
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', theme === 'dark' ? '#111111' : '#FFFFFF');
  };

  paint(root.dataset.theme ?? 'light');

  // Los ítems: el activo en tinta con sus puntos; los demás, sin puntos.
  const itemsNav = [...document.querySelectorAll<HTMLButtonElement>('[data-item]')];
  document.addEventListener('spook:paso', (e) => {
    const { nombre, pasos, paso } = (e as CustomEvent).detail as {
      nombre: string; pasos: number; paso: number;
    };
    itemsNav.forEach((item) => {
      const activo = item.dataset.item === nombre;
      item.classList.toggle('on', activo);
      if (activo) item.setAttribute('aria-current', 'step');
      else item.removeAttribute('aria-current');
      const puntos = item.querySelector('.puntos');
      if (!puntos) return;
      const n = activo ? pasos : 0;
      if (puntos.children.length !== n) {
        puntos.replaceChildren(...Array.from({ length: n }, () => document.createElement('i')));
      }
      [...puntos.children].forEach((p, i) => p.classList.toggle('on', i === paso));
    });
  });

  itemsNav.forEach((item) =>
    item.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('spook:ir', { detail: { nombre: item.dataset.item } }));
    }),
  );

  button?.addEventListener('click', () => {
    paint(root.dataset.theme === 'dark' ? 'light' : 'dark');
    try {
      localStorage.setItem(KEY, root.dataset.theme!);
    } catch {
      /* Navegación privada: el tema dura lo que dure la pestaña. */
    }
  });
</script>
