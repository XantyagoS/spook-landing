---
/**
 * El fantasma-recibo de Spook.
 *
 * Va en línea y con `fill: currentColor` a propósito: así toma el color del
 * texto y cambia solo con el tema. Con un PNG haría falta invertirlo con un
 * filtro en modo oscuro, que es un apaño y se ve peor.
 *
 * Origen: marketing/brand/Spook.svg
 *
 * Son tres paths: el cuerpo y un ojo cada uno. Por eso los ojos se pueden
 * animar por separado — si algún día se re-traza el logo, comprobar que sigan
 * siendo piezas independientes o el parpadeo dejará de funcionar.
 *
 * Las cejas NO son del logo: se añadieron aquí, en coordenadas del lienzo
 * (1024), sobre cada ojo. Están ocultas; las enciende quien use el logo
 * (Fantasma, en Cómo funciona). Van con clase propia — igual que los ojos —
 * porque un selector por posición (`path:nth-of-type`) las confundiría.
 */
interface Props {
  class?: string;
  /** Da vida a los ojos: parpadean y miran hacia arriba cada pocos segundos. */
  vivo?: boolean;
}
const { class: className, vivo = false } = Astro.props;
---

<svg
  class:list={[className, { vivo }]}
  viewBox="0 0 1024.000000 1024.000000"
  fill="currentColor"
  role="img"
  aria-label="Spook"
  preserveAspectRatio="xMidYMid meet"
><g transform="translate(0.000000,1024.000000) scale(0.100000,-0.100000)"
