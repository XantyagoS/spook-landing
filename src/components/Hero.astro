---
/**
 * La frase de la landing. Una pantalla, sin movimiento.
 *
 * El texto se escribe en caja baja y las versales las pone el CSS, para que
 * buscadores y lectores de pantalla lean una frase normal.
 *
 * OJO al añadir o cambiar líneas: el h1 va en `nowrap`, así que un
 * desbordamiento NO avisa — simplemente se sale por el lado. La línea más
 * larga tiene que caber en el ancho de la columna.
 */
import Section from './Section.astro';
---

<Section id="inicio" label="Inicio">
  <div class="centro">
    <h1>
      <span>Spook AI</span>
      <span>Tú y tu</span>
      <span>dinero,</span>
      <span>en paz</span>
    </h1>
  </div>
</Section>

<style>
  .centro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: var(--type-display);
    font-weight: 700;
    /* Versales por CSS y no tocando el texto, para que lo que lean los
       buscadores y los lectores de pantalla siga siendo una frase normal. */
    text-transform: uppercase;
    /* NO bajar de 0.92. Es tentador cerrar más, porque las versales no tienen
       astas ni colas — pero en español SÍ tienen acentos, y una Á o una Ó
       suben mucho más que una mayúscula normal. Medido en esta tipografía:
       mayúscula 0.713em, acentuada 0.901em. Con la cola de las versales
       (0.016em), el piso donde dejan de chocar es 0.917em; a 0.88 la tilde de
       la Ú se metía dentro de la línea de arriba. */
    line-height: 0.96;
    /* Y necesitan menos tracking negativo, o se tocan entre ellas. */
    letter-spacing: -0.02em;
    text-wrap: nowrap;
    color: var(--fg);
    transition: color 0.28s ease;
  }

  /* Hijos DIRECTOS: cada uno es una línea del titular. El combinador `>` no es
     cosmético — con `h1 span` la regla alcanzaba también a la coma anidada y la
     convertía en bloque, partiendo la línea en dos.

     Y no bastaba con darle `display: inline` a la coma: el ámbito de Astro le
     pone su atributo a CADA elemento del selector, así que
     `h1[data-x] span[data-x]` (0,2,2) pesa más que `.acento[data-x]` (0,2,0).
     Una clase no siempre gana aquí. */
  h1 > span {
    display: block;
  }

</style>
