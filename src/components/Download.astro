---
/**
 * Descarga: el llamado y los dos botones a las tiendas. Es la ÚLTIMA
 * sección, y por eso lleva el pie. (Su texto de «por qué Spook» se mudó a
 * Qué es.)
 *
 * La disposición (texto + teléfono) y la animación de entrada vienen de
 * Split.astro. Aquí solo vive lo propio de esta sección: el signo en lima y
 * los botones.
 */
import Split from './Split.astro';
import Footer from './Footer.astro';
---

<Split
  id="descargar"
  label="¡Descárgala ya!"
  nombre="Descarga"
  src="/assets/landing/iphone.png"
  alt=""
  width={389}
  height={800}
  pantalla={{
    imagenes: [
      { src: '/assets/landing/descarga-inicio.webp', alt: 'Spook instalada en la pantalla de inicio de un iPhone' },
    ],
    fondo: '#FFFFFF',
  }}
>
  <h2>Descárgala ya<span class="signo">!</span></h2>
  <p>
    ¿Qué esperas para empezar a registrar tus gastos y mejorar tu relación con
    el dinero?
  </p>
    <div class="actions">
      <a class="btn ink" data-descarga href="https://apps.apple.com/app/id6772789512" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M16.4 12.7c0-2 1.6-2.9 1.7-3-1-1.4-2.4-1.6-2.9-1.6-1.2-.1-2.4.7-3 .7-.6 0-1.6-.7-2.6-.7-1.3 0-2.6.8-3.2 2-1.4 2.4-.4 6 1 8 .7 1 1.4 2 2.4 2 1 0 1.3-.6 2.5-.6s1.5.6 2.5.6 1.7-.9 2.3-1.9c.7-1.1 1-2.2 1-2.2s-1.9-.8-1.9-2.9zM14.5 6.3c.5-.7.9-1.6.8-2.5-.8 0-1.7.5-2.3 1.2-.5.6-1 1.5-.8 2.4.9 0 1.7-.5 2.3-1.1z" />
        </svg>
        App Store
      </a>

      <a class="btn accent" data-descarga href="https://play.google.com/store/apps/details?id=co.spook.app" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M3.6 1.9a1.4 1.4 0 0 0-.6 1.2v17.8c0 .5.2.9.6 1.2l9.4-10.1L3.6 1.9z" />
          <path d="M16.7 8.6 5.2 1.5a1.3 1.3 0 0 0-1.6.4l9.4 10.1 3.7-3.4z" />
          <path d="M13 12l-9.4 10.1c.4.4 1.1.5 1.6.2l11.5-7.1L13 12z" />
          <path d="M20.4 10.7 17.4 9l-4 3 4 3 3-1.7c1-.6 1-2 0-2.6z" />
        </svg>
        Google Play
      </a>
    </div>

  <Footer slot="pie" />
</Split>

<style>
  /* El signo va en el acento. Es decoración, no texto que haya que leer: el
     título se entiende igual sin él, así que el bajo contraste del lima sobre
     blanco aquí no estorba. */
  .signo {
    color: var(--accent);
    transition: color 0.28s ease;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    /* 48px de alto mínimo: por debajo de eso deja de ser cómodo con el dedo. */
    min-height: 52px;
    padding: 0 1.5rem;
    border-radius: 999px;
    font-size: var(--type-small);
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.28s ease,
      color 0.28s ease,
      transform 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.18s ease;
  }
  .btn:hover { transform: translateY(-2px); }
  .btn:active { transform: translateY(0); }

  .btn svg {
    width: 20px;
    height: 20px;
    flex: none;
  }

  /* El "negro" es en realidad la TINTA: en tema oscuro se invierte solo, si no
     sería un botón negro sobre fondo negro. */
  .btn.ink {
    background: var(--fg);
    color: var(--bg);
  }
  .btn.ink:hover { filter: brightness(1.25); }

  /* El acento no cambia con el tema — igual que dentro de la app. */
  .btn.accent {
    background: var(--accent);
    color: var(--on-accent);
  }
  .btn.accent:hover { filter: brightness(1.06); }
</style>
