---
/**
 * Reportes: cada quincena, cómo te fue — en los cuatro pasos que tiene el
 * reporte en la app (balance, gastos, sugerencias, calificación).
 *
 * Fiel al contrato del backend (spook-backend/docs/report-contract.md):
 * cortes 1–15 y 16–fin de mes; las sugerencias pueden proponer topes de
 * presupuesto (que el usuario aplica, la IA no los escribe); las respuestas
 * de la calificación ajustan el TONO del siguiente reporte. OJO: en la app
 * el reporte es solo premium — el texto no lo dice todavía.
 *
 * Textos en BORRADOR. En el teléfono, una captura real de la lista de reportes.
 */
import Split from './Split.astro';
import Items from './Items.astro';

const pasos = [
  {
    nombre: 'Balance',
    detalle: 'Lo que entró y lo que salió.',
    icono: '<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>',
  },
  {
    nombre: 'Tus gastos',
    detalle: 'Dónde se te fue el dinero.',
    icono: '<path d="M21 12c.552 0 1.005-.449.95-.998a10 10 0 0 0-8.953-8.951c-.55-.055-.998.398-.998.95v8a1 1 0 0 0 1 1z"/><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/>',
  },
  {
    nombre: 'Sugerencias',
    detalle: 'Qué hacer y topes a tu medida.',
    icono: '<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>',
  },
  {
    nombre: 'Tu opinión',
    detalle: 'Tu respuesta afina el siguiente.',
    icono: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
  },
];
---

<Split
  id="reportes"
  label="¿Reportes? ¡A ver!"
  nombre="Cómo funciona"
  src="/assets/landing/iphone.png"
  alt=""
  width={389}
  height={800}
  pantalla={{
    imagenes: [
      { src: '/assets/landing/reportes-lista.webp', alt: 'La lista de reportes quincenales, con el último destacado' },
    ],
    fondo: '#FFFFFF',
  }}
>
  <h2>Tus reportes</h2>
  <p>Cada quincena, al ritmo de tu pago, Spook te cuenta cómo te fue.</p>
  <Items items={pasos} />
</Split>
