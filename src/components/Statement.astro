---
/**
 * El remate del hero: una frase enorme que se arma sola a medida que entra
 * en pantalla. Es la promesa dicha en el tamaño que merece.
 */
---
<section class="statement" id="como">
  <p class="claim">
    <span class="w">Tú</span>
    <span class="w">no</span>
    <span class="w">anotas</span>
    <span class="w">nada.</span>
  </p>
  <p class="foot">
    Ni el monto, ni el comercio, ni la fecha, ni la categoría.
    Spook lee la factura y la guarda por ti.
  </p>
</section>

<style>
  .statement {
    background: var(--color-night);
    padding: clamp(7rem, 22vw, 14rem) 1.5rem clamp(7rem, 20vw, 13rem);
    text-align: center;
    view-timeline-name: --claim;
    view-timeline-axis: block;
  }

  .claim {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0 0.28em;
    max-width: 16ch;
    margin: 0 auto;
    font-size: clamp(3rem, 14vw, 8.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--color-chalk);
  }

  /* Cada palabra empieza casi apagada y se enciende con el scroll. */
  .w { color: color-mix(in srgb, var(--color-chalk) 18%, transparent); }

  .foot {
    max-width: 34ch;
    margin: clamp(2.5rem, 7vw, 4rem) auto 0;
    font-size: clamp(1rem, 4vw, 1.25rem);
    line-height: 1.5;
    color: var(--color-chalk-3);
  }

  @supports (animation-timeline: view()) {
    .w {
      animation: word-on linear both;
      animation-timeline: --claim;
    }
    .w:nth-child(1) { animation-range: entry 22% entry 46%; }
    .w:nth-child(2) { animation-range: entry 30% entry 54%; }
    .w:nth-child(3) { animation-range: entry 38% entry 62%; }
    .w:nth-child(4) { animation-range: entry 46% entry 70%; }
  }

  @keyframes word-on {
    to { color: var(--color-chalk); }
  }

  @media (prefers-reduced-motion: reduce) {
    .w { color: var(--color-chalk); animation: none; }
  }
</style>
